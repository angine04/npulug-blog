<back-to-top-control>
  <a href="#top" class="back-to-top" aria-label="返回顶部" title="返回顶部">&uarr;</a>
</back-to-top-control>

<script>
  class BackToTopControl extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const link = this.querySelector<HTMLAnchorElement>("a")!;
      const updateVisibility = () => {
        this.toggleAttribute("data-visible", window.scrollY > 300);
      };

      this.setAttribute("data-enhanced", "");
      updateVisibility();
      window.addEventListener("scroll", updateVisibility, { passive: true, signal });
      link.addEventListener("click", (event) => {
        event.preventDefault();
        document.getElementById("top")!.focus({ preventScroll: true });
        window.scrollTo({
          top: 0,
          left: 0,
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "instant"
            : "smooth",
        });
      }, { signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get("back-to-top-control")) {
    customElements.define("back-to-top-control", BackToTopControl);
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: max(
      calc((100vw - min(50vw, var(--content-width))) / 2 - 48px - var(--spacing-xl)),
      calc(var(--spacing-xl) + env(safe-area-inset-right, 0px))
    );
    bottom: calc(var(--footer-height) + var(--spacing-xxl) + env(safe-area-inset-bottom, 0px));
    z-index: 1;
    transition:
      opacity 180ms ease-out,
      transform 180ms cubic-bezier(0.25, 1, 0.5, 1),
      visibility 180ms,
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  back-to-top-control[data-enhanced]:not([data-visible]) .back-to-top {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(4px);
  }

  @media (max-width: 720px) {
    .back-to-top {
      right: calc(var(--spacing-xl) + env(safe-area-inset-right, 0px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
