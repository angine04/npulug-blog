<theme-toggle>
  <button
    type="button"
    class="theme-toggle"
    aria-label="切换到深色模式"
    title="切换到深色模式"
  >
    <svg
      class="icon icon-moon"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <svg
      class="icon icon-sun"
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="5"></circle>
      <path
        d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
      ></path>
    </svg>
  </button>
</theme-toggle>

<script>
  type Theme = "light" | "dark";

  const STORAGE_KEY = "theme";
  const root = document.documentElement;

  const currentTheme = (): Theme =>
    root.dataset.theme === "dark" ? "dark" : "light";

  /**
   * 重新推导主题：优先本地保存的偏好，其次跟随系统。
   * ViewTransition 会重置 <html> 上的属性，所以切换页面后需要重新应用。
   */
  const resolveTheme = (): Theme => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(STORAGE_KEY);
    } catch {
      /* localStorage 不可用（隐私模式）时回退到系统偏好 */
    }
    if (stored === "light" || stored === "dark") return stored;
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  class ThemeToggle extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const button = this.querySelector("button")!;

      const sync = () => {
        const label =
          currentTheme() === "dark" ? "切换到浅色模式" : "切换到深色模式";
        button.setAttribute("aria-label", label);
        button.title = label;
      };

      this.setAttribute("data-enhanced", "");
      sync();

      button.addEventListener(
        "click",
        () => {
          const theme: Theme = currentTheme() === "dark" ? "light" : "dark";
          root.dataset.theme = theme;
          try {
            localStorage.setItem(STORAGE_KEY, theme);
          } catch {
            /* 无法持久化时仍保持当前会话内的切换 */
          }
          sync();
        },
        { signal },
      );

      document.addEventListener(
        "astro:after-swap",
        () => {
          root.dataset.theme = resolveTheme();
          sync();
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get("theme-toggle")) {
    customElements.define("theme-toggle", ThemeToggle);
  }
</script>

<style>
  .theme-toggle {
    position: fixed;
    top: calc(var(--spacing-lg) + env(safe-area-inset-top, 0px));
    right: calc(var(--spacing-lg) + env(safe-area-inset-right, 0px));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-secondary);
    background-color: color-mix(
      in srgb,
      var(--color-background) 85%,
      transparent
    );
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-primary);
    background-color: var(--color-footer-bg);
    border-color: var(--color-primary);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .icon {
    display: block;
  }

  /* 浅色主题显示月亮（点击进入深色），深色主题显示太阳 */
  .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>
