---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import "katex/dist/katex.min.css";
import "../styles/global.css"; // 引入全局样式
import { ClientRouter } from "astro:transitions"; // Use the current recommended name based on deprecation message

const { title, description, pubDate, updatedDate, image } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} image={image} />
    <ClientRouter />
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
